<Application x:Class="Suni.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI, Yu Gothic UI, Malgun Gothic, Microsoft YaHei UI</FontFamily>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1E1F24" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FF26282E" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFEDEDED" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9AA0A6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4C8DFF" />
    </Application.Resources>
</Application>
